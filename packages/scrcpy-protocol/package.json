{
  "name": "@droid-web-display/scrcpy-protocol",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Source-traceable scrcpy v4.1 browser protocol adapter",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "node tools/clean.mjs",
    "build": "tsc -p tsconfig.json",
    "test": "npm run clean && npm run build && node tools/run-tests.mjs",
    "inspect-fixture": "node tools/inspect-fixture.mjs"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  }
}
