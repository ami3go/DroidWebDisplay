# DroidWebDisplay repository ignore rules
# Keep source, documentation, uv.lock, manifests, and intentional fixtures tracked.

# -----------------------------------------------------------------------------
# Python / uv
# -----------------------------------------------------------------------------
.venv/
**/.venv/
.uv-cache/
**/.uv-cache/
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.coverage
.coverage.*
htmlcov/
coverage.xml

# uv.lock is intentionally committed for reproducible installs.
!uv.lock

# -----------------------------------------------------------------------------
# Robot Framework / test evidence
# -----------------------------------------------------------------------------
results/
**/results/
robot-results/
**/robot-results/
test-results/
**/test-results/
evidence/
**/evidence/
artifacts/
**/artifacts/
logs/
**/logs/
output.xml
log.html
report.html
xunit.xml
*.log

